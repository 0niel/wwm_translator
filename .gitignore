# Temp files
temp_*
test.py

# Data directories (large files)
data/source/dat/
data/packed/

# Keep extracted CSVs for sync (needed for translation)
# Only ignore backup files in source/csv
data/source/csv/*backup*
data/source/csv/*.bak

# Progress - keep JSON files for sync across machines
# Only ignore backup files
data/progress/*_backup_*
data/progress/*.bak

# Translated files - keep CSVs for GitHub editing
data/translated/*.dat
data/translated/packed*/
data/translated/game_ready*

# Ignore backup files
data/translated/*backup*
data/translated/*.bak

# Keep translation CSVs in git
!data/translated/*.csv

# Keep final translation files for download (EN patch)
!data/translated/translate_words_map_en
!data/translated/translate_words_map_en_diff

# Keep directory structure with .gitkeep
!**/.gitkeep

_*.py
_*.txt

# OS
.DS_Store
Thumbs.db

# Secrets
.env
!.env.example
